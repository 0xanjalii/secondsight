# SecondSight Configuration Template
# -------------------------------------------------------------
# AssemblyAI API Key (powers real-time Speech-to-Text & Text-to-Speech)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# AssemblyAI Conversational Voice ID (e.g. Audrey or custom voice)
ASSEMBLYAI_VOICE_ID=49c443a4-8a1d-5f7e-b70b-98bdbd9823c3

# OpenRouter API Key (powers Lumen's multimodal vision analysis & reasoning)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Vision model choice (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MAX_TOKENS=250

# Web server port
PORT=3000

